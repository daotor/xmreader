{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "xmreader",
  "outputfilename": "xmreader",
  "frontend:install": "bun install",
  "frontend:build": "bun run build",
  "frontend:dev:watcher": "bun run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "",
    "email": ""
  },
  "info": {
    "companyName": "XMReader",
    "productName": "XMReader",
    "productVersion": "1.0.0",
    "comments": "Lightweight cross-platform Markdown reader built with Go, Wails, and Vue",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "mdc",
        "name": "AI Agent Rules Document",
        "description": "AI Agent Rules Markdown Document",
        "iconName": "appicon",
        "role": "Viewer"
      }
    ]
  }
}
